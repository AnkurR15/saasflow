{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "#components/*": ["./src/components/*.tsx"],
      "#lib/*": ["./src/lib/*.ts"],
      "#hooks/*": ["./src/hooks/*.ts"],
      "@repo/ui/globals.css": ["../../packages/ui/src/styles/globals.css"],
      "@repo/ui/*": ["../../packages/ui/src/*"]

    },
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
