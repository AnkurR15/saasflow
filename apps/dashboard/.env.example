# Configure the existing database and Auth.js session secret before starting.
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Required for Secure Drop: 64 hex characters from a secure random generator.
# Keep this stable and private. Changing it makes existing drops unreadable.
SECURE_DROP_ENCRYPTION_KEY=
# Exact public origin, without a trailing slash (also used behind Tailscale Serve).
SECURE_DROP_APP_ORIGIN=http://localhost:3001

# Absolute path to private, persistent shared storage for encrypted chunks.
# Every dashboard instance and the cleanup job must use the same volume.
SECURE_DROP_STORAGE_DIR=
